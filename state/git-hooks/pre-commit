#!/usr/bin/env bash
# state/git-hooks/pre-commit — RDF worktree scope enforcement (Wave A)
# (C) 2026 R-fx Networks <proj@rfxn.com>
# GNU GPL v2
#
# Installed by rdf_phase_hook_install (state/rdf-bus.sh); an includeIf "onbranch:rdf/phase-**"
# include makes it the pre-commit hook on phase branches only.
# Rejects commits that touch files outside the phase's declared Files list
# or Tests-may-touch flex zone (plan-schema.md Rule 8).
#
# Bypass: --no-verify (intentional override; dispatcher post-merge check
# serves as defense-in-depth backstop).
set -euo pipefail

_hd="$(command dirname "$0")"

# _rdf_pass — succeed, handing off to the project's own pre-commit when installed by rdf_phase_hook_install
_rdf_pass() {
    if [[ -x "${_hd}/.rdf-passthrough" ]]; then
        export RDF_HOOK_NAME=pre-commit
        exec "${_hd}/.rdf-passthrough"
    fi
    exit 0
}

# Phase branch: rdf/phase-<N>-<SID>. symbolic-ref resolves on empty repos too,
# where rev-parse --abbrev-ref returns "HEAD".
_branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")" # fails on detached HEAD → no-op
_phase_re='^rdf/phase-([0-9]+)-([^/]+)$'
[[ "$_branch" =~ $_phase_re ]] || _rdf_pass
_phase_n="${BASH_REMATCH[1]}"
_sfx="${BASH_REMATCH[2]}"
case "$_sfx" in
    *[!A-Za-z0-9-]*) ;;   # not a session id; the session env decides
    *) export RDF_SESSION_ID="$_sfx" ;;
esac

_top="$(git rev-parse --show-toplevel)"
_main="$_top"
[[ -f "${_hd}/.rdf-main-root" ]] && _main="$(< "${_hd}/.rdf-main-root")"

# RDF's own checkout carries the bus in-tree; every other project uses the deployed copy.
_self_host=0
if [[ -f "${_top}/state/rdf-bus.sh" ]]; then
    _bus="${_top}/state/rdf-bus.sh"
    _self_host=1
else
    _bus="${HOME:-}/.rdf/state/rdf-bus.sh"
fi
if [[ ! -f "$_bus" ]]; then
    echo "rdf pre-commit: rdf-bus.sh not found (checked ${_top}/state and ~/.rdf/state); skipping scope check" >&2
    _rdf_pass
fi
# shellcheck source=/dev/null
source "$_bus"

# _rdf_session_plan root — plan named by root's session-scoped pointer (checked in both roots before any legacy fallback)
_rdf_session_plan() {
    local _ptr="${1}/.rdf/active-plan-${RDF_SESSION_ID:-}" _p
    [[ -n "${RDF_SESSION_ID:-}" && -f "$_ptr" ]] || return 1
    _p="$(< "$_ptr")"
    _p="${_p%[$'\r\n']}"
    [[ -n "$_p" && -f "$_p" ]] || return 1
    printf '%s\n' "$_p"
}
_plan="$(_rdf_session_plan "$_top" || _rdf_session_plan "$_main" \
    || rdf_active_plan_path "$_top" || rdf_active_plan_path "$_main" || true)"  # no pointer anywhere → empty
if [[ -z "$_plan" ]]; then
    echo "rdf pre-commit: no active plan found; skipping scope check" >&2
    _rdf_pass
fi
# Parse phase scope — read loop, not eval; plan files arrive via commits
# (post-3.1.2 canonical workflow) and may carry shell metachars (`;`, `&`)
# in Files entries that bypass rdf_parse_phase_scope's regex-metachar escape.
ALLOWED_REGEX=""
FLEX_REGEX=""
FLEX_FILE_CEILING=""
FLEX_LINE_CEILING=""
while IFS='=' read -r _k _v; do
    case "$_k" in
        ALLOWED_REGEX)     ALLOWED_REGEX="$_v" ;;
        FLEX_REGEX)        FLEX_REGEX="$_v" ;;
        FLEX_FILE_CEILING) FLEX_FILE_CEILING="$_v" ;;
        FLEX_LINE_CEILING) FLEX_LINE_CEILING="$_v" ;;
    esac
done < <(rdf_parse_phase_scope "$_plan" "$_phase_n")
if [[ -z "$ALLOWED_REGEX" ]]; then
    echo "rdf pre-commit: Phase $_phase_n not found in $_plan or has no Files block" >&2
    exit 1
fi

# Build union regex
_scope_regex="$ALLOWED_REGEX"
if [[ -n "${FLEX_REGEX:-}" ]]; then
    _scope_regex="$_scope_regex|$FLEX_REGEX"
fi

# Get staged files
# -z: paths verbatim (default output C-quotes non-ASCII, '"', '\'); an embedded newline becomes \001, which no scope regex matches
_staged="$(git diff --cached --name-only -z | command tr '\n\0' '\001\n')"
if [[ -z "$_staged" ]]; then
    _rdf_pass   # nothing staged
fi

# Validate each staged path
_violations=""
while IFS= read -r _path; do
    if ! [[ "$_path" =~ ^(${_scope_regex})$ ]]; then
        _violations="${_violations:+$_violations}$_path"$'\n'
    fi
done <<< "$_staged"

if [[ -n "$_violations" ]]; then
    echo "rdf pre-commit: SCOPE VIOLATION — files outside Phase $_phase_n scope:" >&2
    echo "$_violations" >&2
    echo "Phase Files allowed: $(echo "$ALLOWED_REGEX" | command tr '|' ' ')" >&2
    [[ -n "${FLEX_REGEX:-}" ]] && echo "Tests-may-touch flex: $(echo "$FLEX_REGEX" | command tr '|' ' ')" >&2
    echo "If this addition is legitimate test-infra, add the path to" >&2
    echo "the phase's **Tests-may-touch:** field in PLAN.md." >&2
    echo "Bypass with --no-verify only if dispatcher post-merge check is acceptable." >&2
    exit 1
fi

# Check ceilings on flex-zone files
if [[ -n "${FLEX_REGEX:-}" ]]; then
    _flex_files=0
    while IFS= read -r _path; do
        if [[ "$_path" =~ ^(${FLEX_REGEX})$ ]]; then
            _flex_files=$((_flex_files + 1))
            # Per-file line ceiling
            _lines="$(git diff --cached --numstat -- "$_path" | awk '{print $1+$2}')"
            if [[ "$_lines" -gt "${FLEX_LINE_CEILING:-30}" ]]; then
                echo "rdf pre-commit: file $_path in flex zone changed $_lines lines (ceiling ${FLEX_LINE_CEILING:-30})" >&2
                exit 1
            fi
        fi
    done <<< "$_staged"
    if [[ "$_flex_files" -gt "${FLEX_FILE_CEILING:-3}" ]]; then
        echo "rdf pre-commit: $_flex_files files in flex zone (ceiling ${FLEX_FILE_CEILING:-3})" >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Anti-pattern grep section (appended after scope-enforcement block above)
# Checks added lines in staged files for five anti-pattern classes.
# Scope enforcement runs FIRST (above); anti-pattern check runs SECOND (here).
#
# Pattern classes (parallel indexed arrays — no declare -A; Bash 4.1+ floor):
#   Class 0: bare-coreutils-no-prefix
#     \b(sha256sum|md5sum|cp|mv|rm|chmod|mkdir|cat|touch|ln)\b without 'command'
#   Class 1: tmp-file-with-pid
#     /tmp/ path containing $$ or $RANDOM
#   Class 2: suppression-no-comment
#     2>/dev/null or || true on a line with no same-line #
#   Class 3: tombstone-phrases
#     replaces .* stub / was: .* / # removed:
#   Class 4: local-rc-mask
#     local <var>=$( — masks subshell exit code
#
# Scope: shell files only (.sh/.bash or a sh/bash shebang). Classes are on for
# RDF's own checkout; other projects opt in via .rdf/governance/ignore.md:
#   # anti-pattern-enable: <class-name>|all
# Suppression: same-line # on the offending line suppresses any class.
# Opt-out (same file, or legacy governance/ignore.md):
#   # anti-pattern-skip: <class-name>
# ---------------------------------------------------------------------------

_AP_CLASSES=(
    "bare-coreutils-no-prefix"
    "tmp-file-with-pid"
    "suppression-no-comment"
    "tombstone-phrases"
    "local-rc-mask"
)

# Regexes — ERE, matched against added diff lines (+ prefix stripped).
# For bare-coreutils: match word-boundary occurrence NOT preceded by 'command '.
# shellcheck disable=SC2016  # $$ and $RANDOM are literal regex tokens, not expansions
_AP_PATTERNS=(
    '\b(sha256sum|md5sum|cp|mv|rm|chmod|mkdir|cat|touch|ln)\b'
    '/tmp/[^"]*\$\$|/tmp/[^"]*\$RANDOM'
    '(2>/dev/null|\|\|[[:space:]]*true)'
    '(replaces[[:space:]].*stub|was:[[:space:]].*|#[[:space:]]*removed:)'
    '^\s*local[[:space:]]+[a-z_]+=\$\('
)

# Load enable/skip directives: main-root .rdf/governance/ignore.md, then legacy governance/ignore.md.
_ap_enabled=()
[[ "$_self_host" -eq 1 ]] && _ap_enabled=("${_AP_CLASSES[@]}")
_ap_skipped=()
_ap_enable_re='^#[[:space:]]*anti-pattern-enable:[[:space:]]*(.+)$'
_ap_skip_re='^#[[:space:]]*anti-pattern-skip:[[:space:]]*(.+)$'
for _igf in "${_main}/.rdf/governance/ignore.md" "${_top}/governance/ignore.md"; do
    [[ -f "$_igf" ]] || continue
    while IFS= read -r _igline; do
        if [[ "$_igline" =~ $_ap_skip_re ]]; then
            _ap_skipped+=("${BASH_REMATCH[1]//[[:space:]]/}")
        elif [[ "$_igline" =~ $_ap_enable_re ]]; then
            _ap_val="${BASH_REMATCH[1]//[[:space:]]/}"
            if [[ "$_ap_val" == "all" ]]; then
                _ap_enabled=("${_AP_CLASSES[@]}")
            else
                _ap_enabled+=("$_ap_val")
            fi
        fi
    done < "$_igf"
done
[[ "${#_ap_enabled[@]}" -gt 0 ]] || _rdf_pass

# _ap_class_enabled name — return 0 if class is in the enabled list
_ap_class_enabled() {
    local _cls="$1" _s
    for _s in "${_ap_enabled[@]+"${_ap_enabled[@]}"}"; do
        [[ "$_s" == "$_cls" ]] && return 0
    done
    return 1
}

_ap_shebang_re='^#!.*(/|[[:space:]])(ba)?sh([[:space:]]|$)'
# _ap_is_shell path — staged path is shell by extension or by its staged shebang
_ap_is_shell() {
    local _l=""
    case "$1" in *.sh|*.bash) return 0 ;; esac
    IFS= read -r _l < <(git cat-file -p ":$1" 2>/dev/null | command head -c 256) || true  # deleted/empty/unreadable blob → no shebang
    [[ "$_l" =~ $_ap_shebang_re ]]
}

# _ap_class_skipped name — return 0 if class is in the skip list
_ap_class_skipped() {
    local _cls="$1" _s
    for _s in "${_ap_skipped[@]+"${_ap_skipped[@]}"}"; do
        [[ "$_s" == "$_cls" ]] && return 0
    done
    return 1
}

# Iterate staged files; grep each added diff hunk.
_ap_found=0
while IFS= read -r _ap_path; do
    _ap_is_shell "$_ap_path" || continue
    # Extract only added lines from the diff (strip leading '+', skip '+++' headers).
    _ap_diff="$(git diff --cached -U0 -- "$_ap_path" \
        | grep -E '^\+[^+]' \
        | command sed 's/^\+//')" || true  # grep exits 1 when no added lines; safe

    [[ -z "$_ap_diff" ]] && continue

    # Drop lines carrying a same-line '#' (suppression) once, so each class greps the
    # remaining added lines a single time instead of once per line.
    _ap_scan="$(grep -vE '#' <<< "$_ap_diff" || true)"  # rc1 when every line has #; safe
    [[ -z "$_ap_scan" ]] && continue

    _ap_i=0
    for _ap_class in "${_AP_CLASSES[@]}"; do
        _ap_pat="${_AP_PATTERNS[$_ap_i]}"
        _ap_i=$((_ap_i + 1))

        _ap_class_enabled "$_ap_class" || continue
        _ap_class_skipped "$_ap_class" && continue

        # One grep over all remaining added lines for this class.
        _ap_hits="$(grep -E "$_ap_pat" <<< "$_ap_scan" || true)"  # rc1 when no match; safe
        [[ -z "$_ap_hits" ]] && continue

        # For bare-coreutils: drop lines where 'command ' precedes the util (valid usage).
        if [[ "$_ap_class" == "bare-coreutils-no-prefix" ]]; then
            _ap_hits="$(grep -vE 'command[[:space:]]+(sha256sum|md5sum|cp|mv|rm|chmod|mkdir|cat|touch|ln)\b' <<< "$_ap_hits" || true)"  # rc1 when all command-prefixed; safe
            [[ -z "$_ap_hits" ]] && continue
        fi

        # Report each offending line.
        while IFS= read -r _ap_line; do
            [[ -z "$_ap_line" ]] && continue
            echo "rdf pre-commit: ANTI-PATTERN [$_ap_class] in $_ap_path:" >&2
            echo "  $_ap_line" >&2
            echo "  Suppress with a same-line # comment explaining why this is safe," >&2
            echo "  or add '# anti-pattern-skip: $_ap_class' to .rdf/governance/ignore.md." >&2
            _ap_found=1
        done <<< "$_ap_hits"
    done
done <<< "$_staged"

if [[ "$_ap_found" -ne 0 ]]; then
    exit 1
fi

_rdf_pass
