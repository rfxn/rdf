diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index f9cf87b..880c13d 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -183,3 +183,27 @@ jobs:
           test -x "$h/.rdf/state/s.sh"
           test "$(cat "$h/.rdf/state/.rdf-version")" = "9.9.9"
           echo "bash 3.2 bootstrap smoke (sanity-exit + copy paths): OK"
+
+      - name: Smoke phase scope guard under system bash 3.2 (macOS)
+        if: runner.os == 'macOS'
+        run: |
+          h="$(mktemp -d)"; mkdir -p "$h/.rdf/state/git-hooks"
+          cp state/rdf-bus.sh "$h/.rdf/state/"
+          cp state/git-hooks/pre-commit "$h/.rdf/state/git-hooks/"
+          repo="$(mktemp -d)/app"; mkdir -p "$repo/.rdf"
+          git -C "$repo" init -q
+          printf 'echo a\n' > "$repo/a.sh"
+          printf '### Phase 1: x\n\n**Files:**\n- Modify: `a.sh`\n' > "$repo/p.md"
+          printf '%s\n' "$repo/p.md" > "$repo/.rdf/active-plan"
+          printf '.rdf/\n' >> "$repo/.git/info/exclude"
+          git -C "$repo" add a.sh p.md
+          git -C "$repo" -c user.email=t@t -c user.name=t commit -q -m init
+          HOME="$h" /bin/bash -c 'source "$HOME/.rdf/state/rdf-bus.sh" && rdf_phase_hook_install "$1"' _ "$repo"
+          git -C "$repo" checkout -q -b rdf/phase-1-x
+          printf 'x\n' > "$repo/outside.txt"; git -C "$repo" add outside.txt
+          if HOME="$h" PATH="/bin:/usr/bin:$PATH" git -C "$repo" -c user.email=t@t -c user.name=t commit -q -m oob 2> "$h/err"; then
+            echo "out-of-scope commit was not rejected under system bash 3.2" >&2
+            exit 1
+          fi
+          grep -q 'SCOPE VIOLATION' "$h/err"
+          echo "bash 3.2 phase scope guard smoke: OK"
diff --git a/CHANGELOG b/CHANGELOG
index 4c8bc08..5a3a2b6 100644
--- a/CHANGELOG
+++ b/CHANGELOG
@@ -1,5 +1,34 @@
 # RDF Changelog
 
+## Unreleased
+
+-- New Features --
+
+[New] rdf_phase_hook_install / rdf_phase_hook_uninstall (state/rdf-bus.sh): activate
+      the phase scope guard on rdf/phase-* branches through an includeIf "onbranch:"
+      include that chains the project's own hooks; uninstall removes the include,
+      .git/rdf-hooks.inc and .git/rdf-hooks/; needs git >= 2.23 (rc 2 below, where
+      /r-build keeps the post-merge scope check)
+
+-- Bug Fixes --
+
+[Fix] phase scope guard never engaged outside RDF's own checkout: /r-build copied the
+      hook to .git/worktrees/<id>/hooks, which git never reads, and the hook found its
+      helpers only through an in-tree state/rdf-bus.sh; it now installs through
+      rdf_phase_hook_install and reads ~/.rdf/state (I-2)
+[Fix] pre-commit hook takes the session id from the phase branch name (no
+      CLAUDE_CODE_SESSION_ID needed: Codex sessions, manual commits) and checks the
+      worktree's and the main worktree's session pointers before legacy fallbacks
+[Fix] /r-build worktree dispatch payload carries PROJECT_ROOT_MAIN, which dispatcher
+      steps (a) and (b) already read
+
+-- Changes --
+
+[Change] pre-commit anti-pattern classes scan shell files only (.sh/.bash or a sh/bash
+         shebang; .bats excluded) and are off outside RDF's own checkout unless enabled
+         with "# anti-pattern-enable: <class>|all" in .rdf/governance/ignore.md, where
+         opt-outs are now read too
+
 ## 3.8.0
 
 -- New Features --
