diff --git a/lib/cmd/sync.sh b/lib/cmd/sync.sh
index b2bca45..96a725b 100644
--- a/lib/cmd/sync.sh
+++ b/lib/cmd/sync.sh
@@ -42,6 +42,7 @@ cmd_sync() {
     local target="claude-code"
     local changed=0
     local unchanged=0
+    local skipped=0
 
     while [[ $# -gt 0 ]]; do
         case "$1" in
@@ -64,6 +65,11 @@ cmd_sync() {
