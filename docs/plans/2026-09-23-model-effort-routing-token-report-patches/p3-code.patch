+# ── Check: harness — Claude Code settings that change agent effort or context cost ──
+# Reads managed, local, project, and user settings plus env; never writes them.
+_check_harness() {
+    local path="$1"
+    if ! command -v jq >/dev/null 2>&1; then
+        _add_result "harness" "$_WARN" "harness checks skipped (jq not found)"
+        return 0
+    fi
+
+    local cand=() files=() f save_ifs="$IFS"
+    IFS=':'
+    for f in $_HARNESS_MANAGED_PATHS; do
+        cand+=("$f")
+    done
+    IFS="$save_ifs"
+    cand+=("${path}/.claude/settings.local.json" "${path}/.claude/settings.json" "${HOME}/.claude/settings.json")
+    for f in "${cand[@]}"; do
+        [[ -f "$f" ]] && jq -e . "$f" >/dev/null 2>&1 && files+=("$f")  # unparseable settings file → skipped
+    done
+
+    local lvl="${CLAUDE_CODE_EFFORT_LEVEL:-}" lsrc="env"
+    if [[ -z "$lvl" ]]; then
+        for f in "${files[@]+"${files[@]}"}"; do
+            lvl="$(jq -r '.env.CLAUDE_CODE_EFFORT_LEVEL // empty' "$f" 2>/dev/null || true)"  # non-object env → unset
+            [[ -n "$lvl" ]] && { lsrc="$f"; break; }
+        done
+    fi
+    [[ "$lvl" == "auto" ]] && lvl=""
+    case "$lvl" in *[!a-z]*) lvl="(invalid)" ;; esac
+    if [[ -n "$lvl" ]]; then
+        _add_result "harness" "$_WARN" "CLAUDE_CODE_EFFORT_LEVEL=${lvl} (${lsrc}) overrides every agent's effort — RDF per-role routing (xhigh/high/medium) is flattened to ${lvl}; unset it and use /effort <level>, which saves per model and leaves agent effort intact"
+    fi
+
+    local model="${ANTHROPIC_MODEL:-}"
+    if [[ -z "$model" ]]; then
+        for f in "${files[@]+"${files[@]}"}"; do
+            model="$(jq -r '.model // empty' "$f" 2>/dev/null || true)"  # non-string model → treated as unset
+            [[ -n "$model" ]] && break
+        done
+    fi
+    local opus_bound=0
+    case "$model" in
+        ""|default|opus|"opus[1m]"|claude-opus-5-5*) opus_bound=1 ;;
+    esac
+    if [[ $opus_bound -eq 0 ]]; then
+        local shown
+        shown="$(printf '%s' "$model" | command tr -cd 'A-Za-z0-9.[]_-')"
+        _add_result "harness" "$_OK" "main model ${shown} — Opus 5.5 effort check not applicable"
+    else
+        local pin=""
+        [[ -n "$lvl" ]] && pin="CLAUDE_CODE_EFFORT_LEVEL"
+        if [[ -z "$pin" ]]; then
+            for f in "${files[@]+"${files[@]}"}"; do
+                if [[ "$f" != "${HOME}/.claude/settings.json" ]] && jq -e 'has("effortLevel")' "$f" >/dev/null 2>&1; then  # non-object settings → no pin
+                    pin="top-level effortLevel in ${f}"
+                    break
+                fi
+                if jq -e '(.modelSettings // {}) | to_entries | map(select((.key | startswith("claude-opus-5-5")) and (.value | type == "object") and (.value | has("effortLevel")))) | length > 0' "$f" >/dev/null 2>&1; then  # malformed modelSettings → no pin
+                    pin="modelSettings in ${f}"
+                    break
+                fi
+            done
+        fi
+        if [[ -n "$pin" ]]; then
+            _add_result "harness" "$_OK" "Opus 5.5 main-thread effort pinned (${pin})"
+        else
+            local legacy=""
+            if [[ -f "${HOME}/.claude/settings.json" ]] && jq -e 'has("effortLevel")' "${HOME}/.claude/settings.json" >/dev/null 2>&1; then  # absent/unparseable → no legacy note
+                legacy=" (a top-level effortLevel in ~/.claude/settings.json does not apply to Opus 5.5)"
+            fi
+            _add_result "harness" "$_WARN" "Opus 5.5 main thread runs at its 'medium' default — run '/effort xhigh' in a session (saves per model) or add modelSettings claude-opus-5-5 effortLevel xhigh to ~/.claude/settings.json; RDF agents pin their own effort${legacy}"
+        fi
+    fi
+
+    local lim="" src=""
+    for f in "${files[@]+"${files[@]}"}"; do
+        lim="$(jq -r '.bashOutputMaxChars // empty' "$f" 2>/dev/null || true)"  # non-object settings → unset
+        [[ -n "$lim" ]] && { src="bashOutputMaxChars"; break; }
+    done
+    if [[ -z "$lim" ]]; then
+        src="BASH_MAX_OUTPUT_LENGTH"
+        lim="${BASH_MAX_OUTPUT_LENGTH:-}"
+        if [[ -z "$lim" ]]; then
+            for f in "${files[@]+"${files[@]}"}"; do
+                lim="$(jq -r '.env.BASH_MAX_OUTPUT_LENGTH // empty' "$f" 2>/dev/null || true)"  # non-object env → unset
+                [[ -n "$lim" ]] && break
+            done
+        fi
+    fi
+    case "$lim" in
+        ""|*[!0-9]*)
+            _add_result "harness" "$_OK" "Bash output limit at or below platform default"
+            ;;
+        *)
+            if [[ ${#lim} -gt 9 ]] || [[ "$lim" -gt 30000 ]]; then
+                _add_result "harness" "$_WARN" "${src}=${lim} exceeds the 30000 default — large Bash results stay in context for the rest of the session; overflow already spills to a file"
+            else
+                _add_result "harness" "$_OK" "Bash output limit at or below platform default"
+            fi
+            ;;
+    esac
+    return 0
+}
